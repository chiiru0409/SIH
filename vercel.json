{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd mailtrace/frontend && npm install && npm run build",
  "outputDirectory": "mailtrace/frontend/dist",
  "build": {
    "env": {
      "UV_LINK_MODE": "copy"
    }
  },
  "functions": {
    "api/index.py": {
      "includeFiles": "mailtrace/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
