{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd mailtrace/frontend && npm install && npm run build",
  "outputDirectory": "mailtrace/frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
