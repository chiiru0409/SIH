# MailTrace Frontend Environment Configuration
# Local Development (leave blank for automatic http://localhost:8000 default or set explicitly):
# VITE_API_BASE_URL=http://localhost:8000

# Production on Vercel with same-origin /api routing (leave blank or set to empty string):
# VITE_API_BASE_URL=

# Production with separately hosted FastAPI backend (Render / Railway / Fly / AWS):
# VITE_API_BASE_URL=https://your-backend-api-domain.com
