# MAILTRACE — Environment Configuration Template
# Copy this file to .env and configure local values.
# NEVER commit real private keys or secrets to git.

APP_ENV=development
DEBUG=True

# Database Configuration (Leave blank to use SQLite)
# DATABASE_URL=postgresql+asyncpg://mailtrace:mailtrace@localhost/mailtrace

# External API Keys (All optional — fallback deterministic logic active)
OPENAI_API_KEY=
IPINFO_TOKEN=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
GEOIP_DB_PATH=

# Blockchain Anchoring (Step 9)
# Default: false (system functions completely offline without any RPC or wallet)
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_PROVIDER=mock
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_NETWORK=ethereum-sepolia
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=
